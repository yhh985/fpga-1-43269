# Verified against ACA420 ch33, ch10 and ch8 vendor examples; see SOURCES.md.
set_pin_assignment {clk} {LOCATION = K14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {reset_n} {LOCATION = P7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {key_monitor_n} {LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}
set_pin_assignment {iic_0_scl} {LOCATION = R5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP;}
set_pin_assignment {iic_0_sda} {LOCATION = M9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP;}
set_pin_assignment {I2S_BCLK} {LOCATION = L7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {I2S_DI} {LOCATION = P9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE;}
set_pin_assignment {I2S_DO} {LOCATION = L8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {I2S_MCLK} {LOCATION = P8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {I2S_RCLK} {LOCATION = L10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {uart_tx} {LOCATION = E3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[0]} {LOCATION = R1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[1]} {LOCATION = K3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[2]} {LOCATION = J3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[3]} {LOCATION = G6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[4]} {LOCATION = K1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[5]} {LOCATION = L3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[6]} {LOCATION = R2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}
set_pin_assignment {led[7]} {LOCATION = P4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE;}

set_pin_assignment {key_slot_n} {LOCATION = H14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}

set_pin_assignment {key_learn_n} {LOCATION = P6; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}

set_pin_assignment {key_demo_n} {LOCATION = T4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}

set_pin_assignment {link_tx} {LOCATION = E15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}

set_pin_assignment {link_rx} {LOCATION = F13; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}

set_pin_assignment {music_bclk} {LOCATION = F14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN;}

set_pin_assignment {music_lrck} {LOCATION = D16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN;}

set_pin_assignment {music_in} {LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN;}

set_pin_assignment {music_out} {LOCATION = E13; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN;}
